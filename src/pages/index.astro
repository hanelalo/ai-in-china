---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import categories from '../data/categories.json';
import site from '../data/site.json';
import { getProjects } from '../lib/projects.mjs';

const projects = (await getProjects()).sort((a, b) => b.stars - a.stars);
const counts = Object.fromEntries(
  categories.map((c) => [c.id, projects.filter((p) => p.category === c.id).length])
);
const totalStars = projects.reduce((sum, p) => sum + p.stars, 0);
---

<Base title="目录" description={site.description}>
  <section class="hero">
    <h1>中文 AI 社区视角的开源工具生态</h1>
    <p class="tagline">
      {site.tagline} — 源自 DeepSeek harness 社区征集，持续收录中文社区关注的开源项目。
    </p>
    <div class="stats">
      <div class="stat">
        <strong>{projects.length}</strong>
        <span>收录项目</span>
      </div>
      <div class="stat">
        <strong>{categories.length}</strong>
        <span>项目分类</span>
      </div>
      <div class="stat">
        <strong>{totalStars.toLocaleString('en-US')}</strong>
        <span>GitHub Star 总数</span>
      </div>
    </div>
  </section>

  <section class="toolbar" aria-label="搜索与排序">
    <input
      id="search"
      class="search"
      type="search"
      placeholder="搜索项目名、摘要、语言、标签…"
      autocomplete="off"
    />
    <select id="sort" class="sort" aria-label="排序方式">
      <option value="stars">按 Star 排序</option>
      <option value="added">按收录时间</option>
      <option value="name">按名称</option>
    </select>
  </section>

  <nav class="pills" aria-label="分类筛选">
    <button class="pill active" data-filter="all">
      全部 <em>{projects.length}</em>
    </button>
    {categories.map((c) => (
      <button class="pill" data-filter={c.id} title={c.description}>
        {c.labelZh} <em>{counts[c.id] ?? 0}</em>
      </button>
    ))}
  </nav>

  <p class="result-count">
    共 <strong id="visible-count">{projects.length}</strong> 个项目
  </p>

  <section id="grid" class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </section>

  <script>
    const grid = document.getElementById('grid');
    const search = document.getElementById('search');
    const sort = document.getElementById('sort');
    const countEl = document.getElementById('visible-count');
    const pills = Array.from(document.querySelectorAll('[data-filter]'));
    const cards = Array.from(grid.querySelectorAll('[data-card]'));
    let activeCategory = 'all';

    function apply() {
      const q = search.value.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const okCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const okQuery = !q || (card.dataset.search ?? '').includes(q);
        const show = okCategory && okQuery;
        card.hidden = !show;
        if (show) visible += 1;
      }
      countEl.textContent = String(visible);
    }

    search.addEventListener('input', apply);
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.toggle('active', p === pill));
        activeCategory = pill.dataset.filter ?? 'all';
        apply();
      });
    });
    sort.addEventListener('change', () => {
      const key = sort.value;
      cards.sort((a, b) => {
        if (key === 'stars') return Number(b.dataset.stars) - Number(a.dataset.stars);
        if (key === 'added') return (b.dataset.added ?? '').localeCompare(a.dataset.added ?? '');
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      });
      for (const card of cards) grid.appendChild(card);
      apply();
    });
  </script>
</Base>
